<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SaberMetrics - Dashboard de Bateo Pro</title>
    <!-- Tailwind CSS para el diseño -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- FontAwesome para los Iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- html2pdf para exportar reportes -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        .spray-field {
            cursor: crosshair;
        }
        @media print {
            .no-print { display: none !important; }
            .pdf-page { width: 297mm; height: 210mm; padding: 10mm; }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen">

    <!-- Navegación Superior -->
    <header class="bg-slate-800 border-b border-slate-700 p-4 no-print shadow-md">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-baseball-bat-ball text-emerald-400 text-3xl"></i>
                <h1 class="text-2xl font-black tracking-wider text-white">SABER<span class="text-emerald-400">METRICS</span></h1>
            </div>
            <div class="flex gap-3">
                <button onclick="exportarPDF()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-4 rounded-lg shadow transition flex items-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-file-pdf"></i> Exportar Reporte
                </button>
            </div>
        </div>
    </header>

    <!-- Contenedor Principal -->
    <main class="max-w-7xl mx-auto p-4 lg:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 pdf-page">
        
        <!-- Panel Izquierdo: Control de Róster e Inputs (no-print en PDF si deseas solo el reporte) -->
        <section class="lg:col-span-4 bg-slate-800 border border-slate-700 rounded-xl p-5 shadow-xl flex flex-col gap-5 no-print">
            <div>
                <h2 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-users text-emerald-400"></i> Control de Jugadores
                </h2>
                <div class="flex gap-2 mb-3">
                    <select id="select-jugador" onchange="cargarJugadorSeleccionado()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                        <!-- Jugadores cargados dinámicamente -->
                    </select>
                    <button onclick="nuevoJugador()" class="bg-slate-700 hover:bg-slate-600 p-2 rounded-lg text-emerald-400 font-bold transition cursor-pointer" title="Añadir Jugador">
                        <i class="fa-solid fa-plus text-lg"></i>
                    </button>
                </div>
            </div>

            <hr class="border-slate-700">

            <!-- Inputs de Estadísticas Básicas -->
            <div class="flex flex-col gap-3 overflow-y-auto max-h-[50vh] pr-1">
                <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">Datos de Temporada (Inputs)</h3>
                
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-slate-400 block mb-1 font-medium">Turnos al Bate (AB)</label>
                        <input type="number" id="in-ab" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1 font-medium">Hits Totales (H)</label>
                        <input type="number" id="in-h" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <label class="text-xs text-slate-400 block mb-1 font-medium">Dobles (2B)</label>
                        <input type="number" id="in-2b" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1 font-medium">Triples (3B)</label>
                        <input type="number" id="in-3b" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1 font-medium">Jonrones (HR)</label>
                        <input type="number" id="in-hr" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-slate-400 block mb-1 font-medium">Bases por Bola (BB)</label>
                        <input type="number" id="in-bb" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1 font-medium">Pelotazos (HBP)</label>
                        <input type="number" id="in-hbp" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="text-xs text-slate-400 block mb-1 font-medium">Sacrificios (SF)</label>
                    <input type="number" id="in-sf" value="0" min="0" oninput="actualizarEstadisticasMatematicas()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-center text-white focus:border-emerald-500 focus:outline-none">
                </div>
            </div>

            <button onclick="eliminarJugadorActual()" class="mt-auto text-rose-400 hover:text-rose-300 text-xs font-semibold flex items-center gap-1 justify-center transition cursor-pointer">
                <i class="fa-solid fa-trash"></i> Eliminar jugador del róster
            </button>
        </section>

        <!-- Panel Central y Derecho: Reporte Visual Embebido -->
        <section id="reporte-contenido" class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Ficha del Jugador & Métricas Sabermétricas -->
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 shadow-xl flex flex-col justify-between">
                
                <!-- Perfil -->
                <div class="flex items-center gap-4">
                    <div class="relative group w-20 h-20 bg-slate-900 rounded-full border-2 border-emerald-500 flex items-center justify-center overflow-hidden shadow-inner">
                        <img id="player-img" src="" class="w-full h-full object-cover hidden">
                        <i id="player-icon" class="fa-solid fa-user text-slate-500 text-3xl"></i>
                        <label class="absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition cursor-pointer no-print">
                            <i class="fa-solid fa-camera text-white text-sm"></i>
                            <input type="file" accept="image/*" onchange="subirFoto(event)" class="hidden">
                        </label>
                    </div>
                    <div class="flex-1">
                        <input type="text" id="player-name" value="Nombre Jugador" onchange="guardarCambiosTexto()" class="bg-transparent font-black text-xl text-white border-b border-transparent hover:border-slate-600 focus:border-emerald-500 focus:outline-none w-full py-0.5">
                        <div class="grid grid-cols-2 gap-2 mt-1">
                            <input type="text" id="player-pos" value="Shortstop - SS" onchange="guardarCambiosTexto()" class="bg-transparent text-xs text-emerald-400 font-bold border-b border-transparent hover:border-slate-600 focus:border-emerald-500 focus:outline-none w-full">
                            <input type="text" id="player-bats" value="Batea: Derecha" onchange="guardarCambiosTexto()" class="bg-transparent text-xs text-slate-400 border-b border-transparent hover:border-slate-600 focus:border-emerald-500 focus:outline-none w-full text-right">
                        </div>
                    </div>
                </div>

                <!-- Bloque de Sabermetría Fija -->
                <div class="grid grid-cols-2 gap-3 my-6">
                    <div class="bg-slate-900/60 border border-slate-700/50 p-3 rounded-lg text-center">
                        <span class="text-xs text-slate-400 block font-semibold uppercase tracking-wider">Batting Avg (AVG)</span>
                        <span id="stat-avg" class="text-2xl font-black text-white">.000</span>
                    </div>
                    <div class="bg-slate-900/60 border border-slate-700/50 p-3 rounded-lg text-center">
                        <span class="text-xs text-slate-400 block font-semibold uppercase tracking-wider">On-Base % (OBP)</span>
                        <span id="stat-obp" class="text-2xl font-black text-emerald-400">.000</span>
                    </div>
                    <div class="bg-slate-900/60 border border-slate-700/50 p-3 rounded-lg text-center">
                        <span class="text-xs text-slate-400 block font-semibold uppercase tracking-wider">Slugging % (SLG)</span>
                        <span id="stat-slg" class="text-2xl font-black text-white">.000</span>
                    </div>
                    <div class="bg-slate-900/60 border border-slate-700/50 p-3 rounded-lg text-center bg-gradient-to-br from-slate-900 to-emerald-950/30 border-emerald-500/30">
                        <span class="text-xs text-emerald-400 block font-semibold uppercase tracking-wider">On-Base Plus Slug (OPS)</span>
                        <span id="stat-ops" class="text-3xl font-black text-emerald-300">.000</span>
                    </div>
                </div>

                <!-- Selector de Batazo para el Spray Chart (No-print) -->
                <div class="no-print bg-slate-900 p-3 rounded-lg border border-slate-700">
                    <span class="text-xs font-bold block text-slate-400 mb-2">Marcador de Spray Chart:</span>
                    <div class="grid grid-cols-4 gap-1.5 text-xs font-bold">
                        <label class="flex flex-col items-center p-1.5 bg-slate-800 rounded border border-slate-600 checked-hit cursor-pointer text-center">
                            <input type="radio" name="hit-type" value="1B" checked class="accent-emerald-400 mb-1"> 1B
                        </label>
                        <label class="flex flex-col items-center p-1.5 bg-slate-800 rounded border border-slate-600 checked-hit cursor-pointer text-center">
                            <input type="radio" name="hit-type" value="2B" class="accent-emerald-400 mb-1"> 2B
                        </label>
                        <label class="flex flex-col items-center p-1.5 bg-slate-800 rounded border border-slate-600 checked-hit cursor-pointer text-center">
                            <input type="radio" name="hit-type" value="3B" class="accent-emerald-400 mb-1"> 3B
                        </label>
                        <label class="flex flex-col items-center p-1.5 bg-slate-800 rounded border border-slate-600 checked-hit cursor-pointer text-center">
                            <input type="radio" name="hit-type" value="HR" class="accent-emerald-400 mb-1"> HR
                        </label>
                    </div>
                </div>
            </div>

            <!-- Spray Chart (Gráfico de Campo SVG) -->
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 shadow-xl flex flex-col justify-between relative">
                <div class="flex justify-between items-center mb-2">
                    <h3 class="text-sm font-bold text-slate-300 flex items-center gap-1.5">
                        <i class="fa-solid fa-location-dot text-emerald-400"></i> Gráfico de Conexiones
                    </h3>
                    <button onclick="deshacerUltimoHit()" class="no-print text-xs text-slate-400 hover:text-white flex items-center gap-1 transition cursor-pointer">
                        <i class="fa-solid fa-rotate-left"></i> Deshacer
                    </button>
                </div>

                <!-- Campo de Béisbol SVG Vectorial -->
                <div class="relative w-full aspect-square bg-slate-900 border border-slate-700 rounded-lg overflow-hidden shadow-inner spray-field" onclick="registrarHitMapa(event)">
                    <svg viewBox="0 0 300 300" class="w-full h-full">
                        <!-- Césped Outfield -->
                        <path d="M 150 280 A 190 190 0 0 1 10 140 L 150 140 Z" fill="#155e75" opacity="0.15"/>
                        <path d="M 150 280 A 190 190 0 0 0 290 140 L 150 140 Z" fill="#155e75" opacity="0.15"/>
                        <path d="M 10 140 A 200 200 0 0 1 290 140 L 150 280 Z" fill="#065f46" opacity="0.4"/>
                        <!-- Infield de Tierra -->
                        <path d="M 150 280 L 70 200 A 110 110 0 0 1 230 200 Z" fill="#78350f" opacity="0.4"/>
                        <path d="M 150 280 L 85 215 A 90 90 0 0 1 215 215 Z" fill="#065f46"/>
                        <!-- Líneas de Foul -->
                        <line x1="150" y1="280" x2="10" y2="140" stroke="#cbd5e1" stroke-width="1.5" opacity="0.6" />
                        <line x1="150" y1="280" x2="290" y2="140" stroke="#cbd5e1" stroke-width="1.5" opacity="0.6" />
                        <!-- Almohadillas / Bases -->
                        <rect x="146" y="276" width="8" height="8" transform="rotate(45 150 280)" fill="#fff" /> <!-- Home -->
                        <rect x="146" y="156" width="8" height="8" transform="rotate(45 150 160)" fill="#fff" /> <!-- 2B -->
                        <rect x="86" y="216" width="8" height="8" transform="rotate(45 90 220)" fill="#fff" /> <!-- 3B -->
                        <rect x="206" y="216" width="8" height="8" transform="rotate(45 210 220)" fill="#fff" /> <!-- 1B -->
                        <!-- Montículo del Lanzador -->
                        <circle cx="150" cy="215" r="5" fill="#78350f" opacity="0.6"/>
                    </svg>

                    <!-- Capa donde caen los puntos de calor del jugador de forma dinámica -->
                    <div id="contenedor-puntos-hits" class="absolute inset-0 pointer-events-none"></div>
                </div>
            </div>
        </section>
    </main>

    <!-- LÓGICA DE JAVASCRIPT: Interacción completa y guardado automático -->
    <script>
        // Estructura de Datos e inicialización con almacenamiento en Navegador
        let players = JSON.parse(localStorage.getItem('sabermetrics_players')) || [
            {
                id: 1,
                name: "Miguel Cabrera",
                position: "Designated Hitter - DH",
                bats: "Batea: Derecha",
                photo: "",
                stats: { ab: 120, h: 38, h2b: 8, h3b: 1, hr: 5, bb: 15, hbp: 2, sf: 3 },
                sprayHits: [
                    {x: 50, y: 45, type: '1B'}, {x: 35, y: 30, type: '2B'}, {x: 75, y: 20, type: 'HR'}
                ]
            }
        ];
        
        let currentPlayerId = players[0]?.id || 1;

        // Colores de identificación de marcas de hits en el mapa
        const hitColors = { '1B': '#34d399', '2B': '#60a5fa', '3B': '#facc15', '4B': '#f87171', 'HR': '#f87171' };

        // Al iniciar la app web
        window.onload = function() {
            renderizarListaJugadores();
            cargarJugador(currentPlayerId);
        };

        function renderizarListaJugadores() {
            const select = document.getElementById('select-jugador');
            select.innerHTML = '';
            players.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.textContent = p.name;
                if(p.id === currentPlayerId) opt.selected = true;
                select.appendChild(opt);
            });
        }

        function cargarJugadorSeleccionado() {
            const id = parseInt(document.getElementById('select-jugador').value);
            guardarDatosEnMemoriaCompleta(); 
            currentPlayerId = id;
            cargarJugador(id);
        }

        function cargarJugador(id) {
            const p = players.find(player => player.id === id);
            if (!p) return;

            document.getElementById('player-name').value = p.name;
            document.getElementById('player-pos').value = p.position;
            document.getElementById('player-bats').value = p.bats;
            
            // Inputs numéricos
            document.getElementById('in-ab').value = p.stats.ab;
            document.getElementById('in-h').value = p.stats.h;
            document.getElementById('in-2b').value = p.stats.h2b;
            document.getElementById('in-3b').value = p.stats.h3b;
            document.getElementById('in-hr').value = p.stats.hr;
            document.getElementById('in-bb').value = p.stats.bb;
            document.getElementById('in-hbp').value = p.stats.hbp;
            document.getElementById('in-sf').value = p.stats.sf;

            // Foto de perfil
            const imgEl = document.getElementById('player-img');
            const iconEl = document.getElementById('player-icon');
            if(p.photo) {
                imgEl.src = p.photo;
                imgEl.classList.remove('hidden');
                iconEl.classList.add('hidden');
            } else {
                imgEl.classList.add('hidden');
                iconEl.classList.remove('hidden');
            }

            actualizarEstadisticasMatematicas();
            dibujarPuntosMapaHits(p.sprayHits);
        }

        // Operaciones Sabermétricas de Béisbol Profesional
        function actualizarEstadisticasMatematicas() {
            const ab = Math.max(0, parseInt(document.getElementById('in-ab').value) || 0);
            const h = Math.max(0, parseInt(document.getElementById('in-h').value) || 0);
            const h2b = Math.max(0, parseInt(document.getElementById('in-2b').value) || 0);
            const h3b = Math.max(0, parseInt(document.getElementById('in-3b').value) || 0);
            const hr = Math.max(0, parseInt(document.getElementById('in-hr').value) || 0);
            const bb = Math.max(0, parseInt(document.getElementById('in-bb').value) || 0);
            const hbp = Math.max(0, parseInt(document.getElementById('in-hbp').value) || 0);
            const sf = Math.max(0, parseInt(document.getElementById('in-sf').value) || 0);

            // Fórmulas Oficiales de la MLB
            const avg = ab > 0 ? (h / ab) : 0;
            const denominadorOBP = (ab + bb + hbp + sf);
            const obp = denominadorOBP > 0 ? ((h + bb + hbp) / denominadorOBP) : 0;

            const sencillos = h - (h2b + h3b + hr);
            const basesTotales = (sencillos * 1) + (h2b * 2) + (h3b * 3) + (hr * 4);
            const slg = ab > 0 ? (basesTotales / ab) : 0;
            const ops = obp + slg;

            // Renderizar formato .000 estándar sabermétrico
            document.getElementById('stat-avg').textContent = avg === 0 ? ".000" : avg.toFixed(3).substring(avg.toFixed(3).indexOf('.'));
            document.getElementById('stat-obp').textContent = obp === 0 ? ".000" : obp.toFixed(3).substring(obp.toFixed(3).indexOf('.'));
            document.getElementById('stat-slg').textContent = slg === 0 ? ".000" : slg.toFixed(3).substring(slg.toFixed(3).indexOf('.'));
            document.getElementById('stat-ops').textContent = ops.toFixed(3);

            guardarDatosEnMemoriaCompleta();
        }

        // Interacción con Spray Chart Visual
        function registrarHitMapa(event) {
            const p = players.find(player => player.id === currentPlayerId);
            if (!p) return;

            const rect = event.currentTarget.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width) * 100;
            const y = ((event.clientY - rect.top) / rect.height) * 100;
            
            const tipoSeleccionado = document.querySelector('input[name="hit-type"]:checked').value;

            p.sprayHits.push({ x: x.toFixed(1), y: y.toFixed(1), type: tipoSeleccionado });
            dibujarPuntosMapaHits(p.sprayHits);
            guardarDatosEnMemoriaCompleta();
        }

        function dibujarPuntosMapaHits(listaHits) {
            const contenedor = document.getElementById('contenedor-puntos-hits');
            contenedor.innerHTML = '';
            listaHits.forEach(hit => {
                const punto = document.createElement('div');
                punto.style.position = 'absolute';
                punto.style.left = `${hit.x}%`;
                punto.style.top = `${hit.y}%`;
                punto.style.width = '10px';
                punto.style.height = '10px';
                punto.style.backgroundColor = hitColors[hit.type] || '#fff';
                punto.style.borderRadius = '50%';
                punto.style.transform = 'translate(-50%, -50%)';
                punto.style.border = '1px solid #1e293b';
                punto.style.boxShadow = '0 0 6px rgba(0,0,0,0.6)';
                punto.title = `Batazo: ${hit.type}`;
                contenedor.appendChild(punto);
            });
        }

        function deshacerUltimoHit() {
            const p = players.find(player => player.id === currentPlayerId);
            if (p && p.sprayHits.length > 0) {
                p.sprayHits.pop();
                dibujarPuntosMapaHits(p.sprayHits);
                guardarDatosEnMemoriaCompleta();
            }
        }

        // Gestión del Róster (Añadir/Eliminar/Guardar)
        function nuevoJugador() {
            const nuevoId = players.length > 0 ? Math.max(...players.map(p => p.id)) + 1 : 1;
            const nJugador = {
                id: nuevoId,
                name: "Nuevo Bateador",
                position: "Position - POS",
                bats: "Batea: Ambidiestro",
                photo: "",
                stats: { ab: 0, h: 0, h2b: 0, h3b: 0, hr: 0, bb: 0, hbp: 0, sf: 0 },
                sprayHits: []
            };
            players.push(nJugador);
            currentPlayerId = nuevoId;
            renderizarListaJugadores();
            cargarJugador(nuevoId);
            guardarDatosEnMemoriaCompleta();
        }

        function eliminarJugadorActual() {
            if(players.length <= 1) {
                alert("Debes tener al menos un jugador activo en el róster de análisis.");
                return;
            }
            if(!confirm("¿Seguro que deseas eliminar permanentemente a este jugador?")) return;
            
            players = players.filter(p => p.id !== currentPlayerId);
            currentPlayerId = players[0].id;
            renderizarListaJugadores();
            cargarJugador(currentPlayerId);
            guardarDatosEnMemoriaCompleta();
        }

        function guardarCambiosTexto() {
            const p = players.find(player => player.id === currentPlayerId);
            if(p) {
                p.name = document.getElementById('player-name').value;
                p.position = document.getElementById('player-pos').value;
                p.bats = document.getElementById('player-bats').value;
                
                // Actualizar nombre en el selector dinámico de róster
                const opt = document.querySelector(`#select-jugador option[value="${currentPlayerId}"]`);
                if(opt) opt.textContent = p.name;
                guardarDatosEnMemoriaCompleta();
            }
        }

        function subirFoto(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const p = players.find(player => player.id === currentPlayerId);
                if(p) {
                    p.photo = e.target.result;
                    document.getElementById('player-img').src = p.photo;
                    document.getElementById('player-img').classList.remove('hidden');
                    document.getElementById('player-icon').classList.add('hidden');
                    guardarDatosEnMemoriaCompleta();
                }
            };
            reader.readAsDataURL(file);
        }

        function guardarDatosEnMemoriaCompleta() {
            const p = players.find(player => player.id === currentPlayerId);
            if(p) {
                p.stats.ab = parseInt(document.getElementById('in-ab').value) || 0;
                p.stats.h = parseInt(document.getElementById('in-h').value) || 0;
                p.stats.h2b = parseInt(document.getElementById('in-2b').value) || 0;
                p.stats.h3b = parseInt(document.getElementById('in-3b').value) || 0;
                p.stats.hr = parseInt(document.getElementById('in-hr').value) || 0;
                p.stats.bb = parseInt(document.getElementById('in-bb').value) || 0;
                p.stats.hbp = parseInt(document.getElementById('in-hbp').value) || 0;
                p.stats.sf = parseInt(document.getElementById('in-sf').value) || 0;
            }
            localStorage.setItem('sabermetrics_players', JSON.stringify(players));
        }

        // Impresión Limpia de Reportes a PDF
        function exportarPDF() {
            const elemento = document.getElementById('reporte-contenido');
            const p = players.find(player => player.id === currentPlayerId);
            const nombreArchivo = p ? `Reporte_Sabermetria_${p.name.replace(/\s+/g, '_')}.pdf` : 'Reporte_Bateo.pdf';
            
            const opciones = {
                margin: 10,
                filename: nombreArchivo,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, backgroundColor: '#0f172a' },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };
            html2pdf().set(opciones).from(elemento).save();
        }
    </script>
</body>
</html>
